NODE_ENV=

# Slack alerting supports either-or configuration per monitor:
# - preferred: a Slack incoming webhook URL (scoped to a single channel)
# - fallback: a bot token + channel
# If both are set, the webhook URL takes precedence.

RETRYABLE_MONITORING_SLACK_WEBHOOK_URL=
RETRYABLE_MONITORING_SLACK_TOKEN=
RETRYABLE_MONITORING_SLACK_CHANNEL=
RETRYABLE_MONITORING_PRIVATE_KEY=

BATCH_POSTER_MONITORING_SLACK_WEBHOOK_URL=
BATCH_POSTER_MONITORING_SLACK_TOKEN=
BATCH_POSTER_MONITORING_SLACK_CHANNEL=

ASSERTION_MONITORING_SLACK_WEBHOOK_URL=
ASSERTION_MONITORING_SLACK_TOKEN=
ASSERTION_MONITORING_SLACK_CHANNEL=
